<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:padding="6dp"
    android:background="?attr/selectableItemBackground">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_face"
        android:layout_width="68dp" android:layout_height="68dp"
        android:scaleType="centerCrop" android:contentDescription="Face"/>

    <TextView android:id="@+id/tv_face_name"
        android:layout_width="72dp" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="?attr/colorOnSurface"
        android:gravity="center" android:maxLines="1" android:ellipsize="end"
        android:layout_marginTop="6dp"/>

    <TextView android:id="@+id/tv_face_count"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="10sp" android:textColor="#8B90A8" android:gravity="center"/>
</LinearLayout>
