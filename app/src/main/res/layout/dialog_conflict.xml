<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingBottom="32dp">

    <!-- Handle -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="32dp">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#30FFFFFF"
            android:layout_marginTop="12dp" />
    </FrameLayout>

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conflict_detected"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tv_conflict_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#8B90A8" />
        </LinearLayout>
    </LinearLayout>

    <!-- File info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_filename"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_filesize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#8B90A8"
            android:paddingStart="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#12FFFFFF"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Matched rules list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_conflict_rules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="240dp"
        android:nestedScrollingEnabled="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#12FFFFFF"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btn_upload_selected"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/upload_to_selected"
            android:background="@drawable/bg_gradient_accent"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        <Button
            android:id="@+id/btn_follow_priority"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/follow_priority"
            android:background="@drawable/bg_pill"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btn_always_priority"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/always_follow_priority"
            android:background="@drawable/bg_pill"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btn_cancel_upload"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/cancel_upload"
            android:background="@drawable/bg_pill"
            android:textColor="@color/accent_red"
            style="@style/Widget.MaterialComponents.Button.TextButton" />
    </LinearLayout>

</LinearLayout>
