<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorSurface">

    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="16dp"
        android:background="?attr/colorSurface" android:elevation="4dp">
        <ImageButton android:id="@+id/btn_back"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_back" android:background="@drawable/bg_pill"
            android:padding="8dp" android:tint="?attr/colorOnSurface" android:contentDescription="Back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Settings" android:textSize="20sp"
            android:textStyle="bold" android:textColor="?attr/colorOnSurface" android:paddingStart="12dp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="32dp">

            <!-- APPEARANCE -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="APPEARANCE" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#555A72" android:letterSpacing="0.1"
                android:paddingStart="16dp" android:paddingTop="14dp" android:paddingBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp" app:cardCornerRadius="14dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="#12FFFFFF" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:id="@+id/item_dark_mode"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🌙" android:textSize="20sp"
                            android:background="@drawable/bg_pill" android:padding="8dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/dark_mode" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" android:textStyle="bold"/>
                            <TextView android:id="@+id/tv_theme_desc"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Currently: Dark" android:textSize="11sp" android:textColor="#8B90A8"/>
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_dark_mode"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:checked="true" android:thumbTint="@color/accent_blue"
                            android:trackTint="@color/accent_blue"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BACKUP -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="BACKUP" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#555A72" android:letterSpacing="0.1"
                android:paddingStart="16dp" android:paddingTop="4dp" android:paddingBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp" app:cardCornerRadius="14dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="#12FFFFFF" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="☁️" android:textSize="20sp"
                            android:background="@drawable/bg_pill" android:padding="8dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/auto_backup" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Automatically upload new photos" android:textSize="11sp" android:textColor="#8B90A8"/>
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_auto_backup"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:checked="true" android:thumbTint="@color/accent_blue" android:trackTint="@color/accent_blue"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0CFFFFFF"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🧠" android:textSize="20sp"
                            android:background="@drawable/bg_pill" android:padding="8dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/upload_by_rules" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Apply routing logic to every upload" android:textSize="11sp" android:textColor="#8B90A8"/>
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_rules"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:checked="true" android:thumbTint="@color/accent_blue" android:trackTint="@color/accent_blue"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0CFFFFFF"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📶" android:textSize="20sp"
                            android:background="@drawable/bg_pill" android:padding="8dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/wifi_only" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Don't upload on mobile data" android:textSize="11sp" android:textColor="#8B90A8"/>
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_wifi_only"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:checked="true" android:thumbTint="@color/accent_blue" android:trackTint="@color/accent_blue"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- COMPRESSION -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="COMPRESSION" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#555A72" android:letterSpacing="0.1"
                android:paddingStart="16dp" android:paddingTop="4dp" android:paddingBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp" app:cardCornerRadius="14dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="#12FFFFFF" app:strokeWidth="1dp">
                <LinearLayout android:id="@+id/item_compression"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🗜️" android:textSize="20sp"
                        android:background="@drawable/bg_pill" android:padding="8dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/compression_settings" android:textSize="14sp"
                            android:textColor="?attr/colorOnSurface" android:textStyle="bold"/>
                        <TextView android:id="@+id/tv_compression_summary"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Images: 85% · Videos: 1080p" android:textSize="11sp" android:textColor="#8B90A8"/>
                    </LinearLayout>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_back" android:tint="#8B90A8" android:contentDescription="Open"
                        android:rotation="180"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ROUTING -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ROUTING" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#555A72" android:letterSpacing="0.1"
                android:paddingStart="16dp" android:paddingTop="4dp" android:paddingBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp" app:cardCornerRadius="14dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="#12FFFFFF" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:id="@+id/item_rules"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⚡" android:textSize="20sp" android:background="@drawable/bg_pill" android:padding="8dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/routing_rules" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" android:textStyle="bold"/>
                            <TextView android:id="@+id/tv_rules_summary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0 rules active" android:textSize="11sp" android:textColor="#8B90A8"/>
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_back" android:tint="#8B90A8" android:rotation="180" android:contentDescription="Open"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0CFFFFFF"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🔄" android:textSize="20sp" android:background="@drawable/bg_pill" android:padding="8dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/recalculate_integrity" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Scan for orphaned entries" android:textSize="11sp" android:textColor="#8B90A8"/>
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_back" android:tint="#8B90A8" android:rotation="180" android:contentDescription="Open"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DATA -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DATA" android:textSize="10sp" android:textStyle="bold"
                android:textColor="#555A72" android:letterSpacing="0.1"
                android:paddingStart="16dp" android:paddingTop="4dp" android:paddingBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp" app:cardCornerRadius="14dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="#12FFFFFF" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:id="@+id/item_takeout"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📦" android:textSize="20sp" android:background="@drawable/bg_pill" android:padding="8dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/takeout_import" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Import from Google Takeout ZIP" android:textSize="11sp" android:textColor="#8B90A8"/>
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_back" android:tint="#8B90A8" android:rotation="180" android:contentDescription="Open"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0CFFFFFF"/>
                    <LinearLayout android:id="@+id/item_clear_cache"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🗑️" android:textSize="20sp" android:background="@drawable/bg_pill" android:padding="8dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/clear_cache" android:textSize="14sp"
                                android:textColor="@color/accent_red" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Removes thumbnails and metadata" android:textSize="11sp" android:textColor="#8B90A8"/>
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_back" android:tint="#8B90A8" android:rotation="180" android:contentDescription="Open"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
