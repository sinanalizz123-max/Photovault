<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp"
    android:background="?attr/colorSurface">
    <TextView android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/permission_title" android:textSize="28sp" android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" android:gravity="center"/>
    <TextView android:id="@+id/tv_desc" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/permission_desc" android:textSize="15sp"
        android:textColor="#8B90A8" android:gravity="center" android:layout_marginTop="16dp" android:lineSpacingMultiplier="1.5"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="40dp" android:id="@+id/permission_list"/>
    <Button android:id="@+id/btn_grant" android:layout_width="match_parent" android:layout_height="52dp"
        android:text="@string/grant_permissions" android:textSize="16sp" android:textColor="@color/white"
        android:background="@drawable/bg_gradient_accent" android:layout_marginTop="32dp"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
</LinearLayout>
